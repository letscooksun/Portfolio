# Contact form backend (api/contact.js)
# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.

# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives portfolio messages
CONTACT_TO_EMAIL=shuvayansarkar357@gmail.com

# Sender. Without a verified domain, Resend only allows onboarding@resend.dev,
# and only delivers to the email address your Resend account was created with.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
